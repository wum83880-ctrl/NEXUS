# NEXUS 环境变量模板。复制为 .env 后按需修改。
# 推荐直接运行 `nexus setup`，它会自动生成绝对路径版本的 .env。
DATABASE_URL=file:../db/custom.db

# ── 安全（公网部署必设）────────────────────────────
# 设置后所有 /api 与 Socket 连接都必须携带该令牌。
# NEXUS_ACCESS_TOKEN=your-secret-token
# NEXT_PUBLIC_NEXUS_ACCESS_TOKEN=your-secret-token

# ── 运行环境（可选）───────────────────────────────
# 工作区根目录：工具相对路径的解析基准（默认 = 项目根）。
# NEXUS_WORKSPACE=C:/path/to/project
# 生产 standalone 的监听端口与地址（默认 3000 / 0.0.0.0）。
# PORT=3000
# HOSTNAME=0.0.0.0
